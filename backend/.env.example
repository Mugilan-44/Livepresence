NODE_ENV=development
PORT=5001
LOCAL_DB=true
FRONTEND_URL=http://localhost:3000

# Cloudflare Turnstile (login bot protection)
# The site key is public and belongs in frontend/.env.local. Keep the secret only in backend/.env.local.
TURNSTILE_SECRET_KEY=
# Leave false in local development. Production always enforces Turnstile.
TURNSTILE_ENFORCE_LOCAL=false

# Optional: production MySQL connection
# DATABASE_URL=mysql://user:password@host:3306/database

# Hostinger SMTP for careers@prolync.in. Keep the mailbox password in .env.local only.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=careers@prolync.in
SMTP_FROM=careers@prolync.in
SMTP_FROM_NAME=Prolync LiveSpace
SMTP_PASS=your-hostinger-mailbox-password
