# Local development
NODE_ENV=development
PORT=5001
LOCAL_DB=true
FRONTEND_URL=http://localhost:3000

# Bot protection stays off until a production Turnstile widget is deliberately enabled.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCE_LOCAL=false

# Production — set these directly in Render. Never commit credentials.
# NODE_ENV=production
# LOCAL_DB=false
# DB_HOST=your-aiven-host
# DB_PORT=10208
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA=
# DB_CREATE_DATABASE=false
# DB_CONNECTION_LIMIT=5
# JWT_SECRET=
# FRONTEND_URL=https://your-netlify-site.netlify.app
# COMPANY_NAME=Prolync LiveSpace
# OFFICE_NAME=Main Office
# BOOTSTRAP_FOUNDER_NAME=Rahul Kannan
# BOOTSTRAP_FOUNDER_EMAIL=rahul@prolync.in
# BOOTSTRAP_FOUNDER_PASSWORD=

# Hostinger SMTP — set mailbox credentials only in local/Render environment.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=careers@prolync.in
SMTP_PASS=
SMTP_FROM=careers@prolync.in
SMTP_FROM_NAME=Prolync LiveSpace
